{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command \"@'\nfrom trace import *\nfrom tracker import L,R\nimport sys\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nfrom time import sleep\ndef init():\n    global orient, n\n    orient=np.load('ori.npy')\n    orient=(np.clip(orient*1.05,0,1)**.6*255).astype(np.uint8)\n    n=orient.shape[0]\ndef get3(x,y,t):\n    x=np.clip(x,0,w-2.001); y=np.clip(y,0,h-2.001)\n    i=x.astype(np.int32); j=y.astype(np.int32)\n    u=x-i; v=y-j\n    a=(t*(-n/np.pi))%n\n    lo=a.astype(np.int32); hi=(lo+1)%n; f=a-lo\n    def sub(i,j):\n        return (orient[lo,j,i]*(1-f)+orient[hi,j,i]*f)\n    return ((1-u)*((1-v)*sub(i,j)+v*sub(i,j+1))+u*((1-v)*sub(i+1,j)+v*sub(i+1,j+1)))/255.\ndef run(direction, af=.09, kf=.016, st=7., look=23., at=.14, kt=.12, tail=.65, narrow=1.):\n    sy=L if direction==1 else R\n    ey=R if direction==1 else L\n    sx=450 if direction==1 else 3400\n    ex=3400 if direction==1 else 450\n    x=np.full(50,sx,dtype=np.float32); y=sy.astype('float32'); t=np.full(50,0. if direction==1 else np.pi,dtype='float32')\n    cur=np.zeros(50,np.float32)\n    history=[[ (a,b,tt,1.) ] for a,b,tt in zip(x,y,t)]\n    active=np.ones(50,dtype=bool)\n    a=np.linspace(-af,af,7,dtype='float32')\n    c=np.linspace(-kf,kf,9,dtype='float32')\n    A,C=np.meshgrid(a,c)\n    A=A.reshape(1,-1,1); C=C.reshape(1,-1,1)\n    dist=np.linspace(1.5,look,9,dtype='float32')[None,None,:]\n    wt=(np.array([.7,1,1,1,1,1,1,1,1],dtype='float32')/8.7)[None,None,:]\n    for step in range(1010):\n        k=np.flatnonzero(active)\n        if k.size==0: break\n        kk=np.clip(cur[k,None,None]*tail+C,-.075,.075)\n        aa=t[k,None,None]+A\n        ang=aa+kk*dist/2\n        ch=np.sinc(kk*dist/(2*np.pi))*dist\n        px=x[k,None,None]+np.cos(ang)*ch; py=y[k,None,None]+np.sin(ang)*ch\n        sc=get3(px,py,aa+kk*dist)\n        scores=(sc*w