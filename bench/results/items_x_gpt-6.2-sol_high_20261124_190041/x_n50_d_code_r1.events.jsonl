{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command \"@'\nfrom cnn import *\nfrom scipy.ndimage import gaussian_filter1d\ntorch.set_num_threads(6)\ngrid=np.arange(-22,23,dtype=np.float32)\nraw=img.astype('float32')\nlab=np.array([L,R])\nnang=18\nM=45\ndef synth(n):\n    side=rng.random(n)>.5\n    locx=np.where(side,rng.uniform(3340,3475,n),rng.uniform(328,550,n))\n    iy=rng.integers(0,50,n)\n    locy=lab[side.astype(int),iy].astype('float32')\n    locy+=rng.uniform(-11,11,n)\n    a=rng.uniform(0,np.pi*2,n)\n    def sample(x,y,a):\n        c=np.cos(a)[:,None,None]; s=np.sin(a)[:,None,None]\n        xx=(x[:,None,None]+c*grid[None,None,:]-s*grid[None,:,None]).astype('float32').reshape(n*M,M)\n        yy=(y[:,None,None]+s*grid[None,None,:]+c*grid[None,:,None]).astype('float32').reshape(n*M,M)\n        vals=cv2.remap(raw,xx,yy,cv2.INTER_LINEAR).reshape(n,M,M,3)\n        tar=cv2.remap(target,xx,yy,cv2.INTER_LINEAR).reshape(n,M,M)\n        return vals,tar,yy.reshape(n,M,M)\n    b,t,y=sample(locx,locy,a)\n    adeg=np.arange(nang)[None,:]*np.pi/nang\n    def angtarget(a):\n        cs=np.cos(2*(a[:,None]+adeg))\n        return np.exp((cs-1)*24).astype('float32')\n    Y=t[:,None,:,:]*angtarget(a)[:,:,None,None]\n    for rep in range(2):\n        theta=a+rng.uniform(.12,np.pi-.12,n)*rng.choice([-1.,1.],n)\n        dy=rng.integers(-4,5,n)\n        jy=(iy+dy).clip(0,49)\n        yref=lab[side.astype(int),jy]\n        ny=yref+rng.uniform(-23,23,n)\n        q,u,yy=sample(locx,ny,theta)\n        # The top strand replaces a strip of surface and casts a shadow.\n        rel=yy-yref[:,None,None]\n        alph=(1/(1+np.exp((np.abs(rel-rng.uniform(-.42,.42,n)[:,None,None])-rng.uniform(2.55,3.65,n)[:,None,None])*3)))\n        prob=(rng.random(n)<(.65 if rep==0 else .20))[:,None,None]\n        alp=alph*prob\n        b=b*(1-alp[:,:,:,None])+q*alp[:,:,:,None]\n        sh=np.exp(-((rel-rng.uniform(4,8,n)[:,None,None])/rng.uniform(1.5,3.2,n)[:,None,None])**2)*rng.uniform(0.,.60,n)[:,None,None]*prob\n        b*=1-sh[:,:,:,None]\n        Y=np.maximum(Y,u[:,None,:,:]*angtarget(theta)[:,:,None,None]*prob[:,None,:,:])\n    if True:\n        b=b*rng.uniform(.74,1.27,(n,1,1,1))+rng.uniform(-12,12,(n,1,1,3))\n    f=[]\n    # Run spatial filters independently per training patch.\n    for i in range(n):\n     gray=b[i,:,:,1].astype(np.float32)\n     a1=cv2.GaussianBlur(gray,(0,0),11)\n     d=[]\n     for j in range(3):\n      v=b[i,:,:,j].astype(np.float32)\n      d.extend([(v-cv2.GaussianBlur(v,(0,0),11))/(25+a1),(v-cv2.GaussianBlur(v,(0,0),2.5))/(25+a1),v/200-.5])\n     f.append(d)\n    return torch.from_numpy(np.array(f)),torch.from_numpy(Y.astype('float32'))\ndef net2():\n c=30\n return nn.Sequential(nn.Conv2d(9,c,5,padding=2),nn.SiLU(),nn.Conv2d(c,c,3,padding=1),nn.SiLU(),nn.Conv2d(c,c,3,padding=1),nn.SiLU(),nn.Conv2d(c,c,3,padding=2,dilation=2),nn.SiLU(),nn.Conv2d(c,c,3,padding=2,dilation=2),nn.SiLU(),nn.Conv2d(c,c,3,padding=3,dilation=3),nn.SiLU(),nn.Conv2d(c,nang,1))\ndef infer(m,flips=False):\n score=np.zeros((nang,)+im.shape,np.float16)\n inputs=[]\n a1=cv2.GaussianBlur(gray,(0,0),11)\n for i in range(3):\n  v=raw[:,:,i]\n  inputs.extend([(v-cv2.GaussianBlur(v,(0,0),11))/(25+a1),(v-cv2.GaussianBlur(v,(0,0),2.5))/(25+a1),v/200-.5])\n inputs=np.array(inputs)\n with torch.no_grad():\n  for y in range(40,2141,180):\n   for x in range(440,3411,220):\n    d=torch.from_numpy(inputs[:,y-14:y+194,x-14:x+234].copy())[None]\n    p=m(d).sigmoid()[0,:,14:-14,14:-14].numpy()\n    if flips:\n        pr=m(d.flip([2,3])).sigmoid()[0,:,14:-14,14:-14].flip([1,2]).numpy()\n        p=(p+pr)/2\n    score[:,y:y+p.shape[1],x:x+p.shape[2]]=p\n return score\nif __name__=='__main__':\n model=net2()\n opt=torch.optim.AdamW(model.parameters(),lr=.0035)\n start=time.time()\n for j in range(1450):\n  x,y=synth(32)\n  p=model(x)[:,:,12:-12,12:-12]; y=y[:,:,12:-12,12:-12]\n  loss=nn.functional.binary_cross_entropy_with_logits(p,y,weight=1.+8.*y)\n  opt.zero_grad(); loss.backward(); opt.step()\n  if j%150==0: print(j,float(loss.detach()),time.time()-start,flush=True)\n  if j==750: opt.param_groups[0]['lr']=.0016\n  if j==1200: opt.param_groups[0]['lr']=.0008\n torch.save(model.state_dict(),'rotweights.pt')\n score=infer(model,True)\n np.save('ori.npy',score)\n np.save('ori_max.npy',score.max(axis=0))\n'@ | Set-Content -Encoding utf8 rotcnn.py\npython rotcnn.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
