,5,6]]\n    Random(307).shuffle(js)\n    with ThreadPoolExecutor(3) as pool:\n     for r in pool.map(job,js): pass\n'@ | Set-Content -Encoding utf8 bridge.py\npython bridge.py\"","aggregated_output":"56 12 12 1 2100 1 0 2=11\r\n56 12 12 2 2195 6 4 2=11,11=1\r\n32 15 9 2 2603 5 3 11=1,23=27\r\n56 9 10 1 2262 3 1 2=11,11=1\r\n45 9 10 0 2090 1 1 \r\n56 7 6 4 2539 6 4 2=11,41=13\r\n56 9 10 6 2422 7 5 2=11,27=28\r\n32 9 10 5 2740 6 4 2=11,25=20\r\n32 12 12 3 2670 19 13 2=11,23=27,25=21,43=13,46=23,49=43\r\n56 15 9 1 1976 0 0 \r\n45 12 12 0 1964 2 1 2=5\r\n32 7 6 5 2958 7 4 2=11,23=27,25=20\r\n56 15 9 2 2067 3 3 \r\n56 9 10 4 2393 5 4 2=11\r\n45 15 9 6 2484 9 7 2=5,12=45\r\n56 12 12 0 1751 0 0 \r\n45 15 9 3 2543 16 10 2=5,10=44,22=32,26=2,32=38,48=50\r\n45 12 12 3 2572 17 10 2=5,22=32,25=25,37=38,40=22,46=6,48=50\r\n32 15 9 6 2648 7 5 25=27,32=43\r\n32 9 10 1 2629 2 1 2=11\r\n45 15 9 0 1964 2 1 2=5\r\n56 15 9 0 1662 0 0 \r\n56 12 12 4 2208 5 4 2=11\r\n32 7 6 6 2984 6 3 2=11,8=15,40=45\r\n32 9 10 4 2797 8 6 2=11,27=36\r\n45 7 6 3 2911 20 10 2=11,8=15,21=50,25=25,27=6,28=2,32=38,38=14,40=22,42=45\r\n56 7 6 6 2554 9 4 2=11,6=15,13=45,27=28,44=42\r\n45 15 9 2 2427 2 2 \r\n56 7 6 3 2629 22 8 2=11,8=15,11=14,13=45,19=19,20=21,23=23,25=20,27=6,31=28,41=13,42=2,48=50,49=24\r\n32 7 6 1 2806 1 1 \r\n45 12 12 5 2395 3 2 2=5\r\n56 7 6 1 2399 2 0 2=11,11=1\r\n45 12 12 4 2469 8 7 2=5\r\n56 9 10 0 1882 0 0 \r\n56 15 9 3 2207 10 8 6=32,49=43\r\n32 15 9 1 2468 1 1 \r\n32 12 12 0 2064 0 0 \r\n45 9 10 1 2505 4 4 \r\n45 7 6 0 2232 1 1 \r\n","exit_code":1,"status":"failed"}}
