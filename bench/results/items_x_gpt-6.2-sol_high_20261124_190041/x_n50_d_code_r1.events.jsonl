{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command \"@'\nfrom bridge import *\nfrom scipy.optimize import milp,Bounds,LinearConstraint\nfrom scipy.sparse import coo_matrix\nimport os\ndef flow(p,d,rad=72,ext=21,anchor=5,limit=55,tune=0):\n    P,B,U,K,LL,Q=fit(p,ext,anchor)\n    N=len(P)\n    G=np.empty(N,int)\n    for i,ls in enumerate(d): G[ls]=i\n    bound=(P[:,0]<454)|(P[:,0]>3396)\n    pairs=set(cKDTree(B).query_pairs(rad))\n    for g in d: pairs.update(combinations(sorted(g),2))\n    PP=np.array(sorted(pairs),np.int32); I,J=PP.T\n    same=G[I]==G[J]\n    keep=(I//2\"'!=J//2)&~(bound[I]|bound[J])\n    PP=PP[keep]; I,J=PP.T; same=same[keep]\n    delta=B[J]-B[I]\n    dd=np.linalg.norm(delta,axis=1)\n    def dot(a,b):return (a*b).sum(axis=-1)\n    def cross(a,b):return a[...,0]*b[...,1]-a[...,1]*b[...,0]\n    t0,t1=U[I],U[J]\n    angle=1+dot(t0,t1)\n    side=(abs(cross(t0,delta))+abs(cross(t1,delta)))/(8+.65*dd)\n    wrong=(np.maximum(0,dot(t0,delta)-1)+np.maximum(0,-dot(t1,delta)-1))/(dd+4)\n    shape=.82*angle+.35*side+1.02*wrong\n    keep=(shape<1.52)|(same&(shape<1.78))\n    PP=PP[keep];I,J=PP.T; same=same[keep]; shape=shape[keep]; dd=dd[keep]\n    result=list(eval_bridge(B,U,K,PP))\n    evidence=np.concatenate([g[0] for g in result])\n    score=shape+.010*dd+(.55+.20*tune)*(.43-evidence)-.10*same\n    a=score[score<.35]\n    keep=(score<1.56)\n    PP=PP[keep]; I,J=PP.T; score=score[keep]\n    anchors={}\n    for z,sx in enumerate((450,3400)):\n        for i,y in enumerate([L,R][z]):\n            ds=np.linalg.norm(P-[sx,y],axis=1)\n            q=int(ds.argmin())\n            if ds[q]<18: anchors[z,i]=q\n    print('\"'setup',N,len(PP),len(anchors),flush=True)\n    # Split every segment end into an incoming and an outgoing state.\n    start=np.arange(N)\n    fin=(start\"'^1)+N\n    src=[start,N+I,N+J]\n    dst=[fin,J,I]\n    # Genuine segments contribute evidence in addition to the bridge cost.\n    len_bonus=np.minimum(1,LL/22)\n    len_bonus2=np.minimum(1,LL/120)\n    vc=[-.18*len_bonus-.12*len_bonus2-.09*(Q-.57)-.11*tune*len_bonus,score,score]\n    bv=np.zeros(2*N)\n    for (z,i),j in anchors.items(): bv[j+N*z]=1 if z==0 else -1\n    S=[j for (z,i),j in anchors.items() if z==0]\n    T=[j+N for (z,i),j in anchors.items() if z==1]\n    skip_s=np.repeat(S,len(T)); skip_t=np.tile(T,len(S))\n    src.append(skip_s); dst.append(skip_t); vc.append(np.full(len(skip_s),24.))\n    src=np.concatenate(src)\n    dst=np.concatenate(dst)\n    costs=np.concatenate(vc)\n    ni=np.arange(len(costs))\n    unit=np.ones(len(costs))\n    r=np.r_[src,dst,2*N+start//2]\n    c=np.r_[ni,ni,start]\n    val=np.r_[unit,-unit,np.ones(len(start))]\n    mat=coo_matrix((val,(r,c)),shape=(2*N+N//2,len(ni))).tocsc()\n    extras=np.full(N//2,1.)\n    con=LinearConstraint(mat,np.r_[bv,np.zeros(N//2)],np.r_[bv,extras])\n    res=milp(costs,constraints=con,integrality=np.ones(len(ni)),bounds=Bounds(np.zeros(len(ni)),np.ones(len(ni))),options={'\"'time_limit':limit,'mip_rel_gap':.001})\n    print('res',res.message,res.fun,getattr(res,'mip_gap',None),flush=True)\n    if res.x is None: return None\n    nz=res.x>.6\n    dic=dict(zip(src[nz],dst[nz]))\n    inv=dict((j+N,i) for (z,i),j in anchors.items() if z==1)\n    paths={}\n    m={}\n    for (z,i),j in anchors.items():\n        if z\"'!=0: continue\n        tr=[]; seen=set()\n        while j not in seen and j not in inv:\n            seen.add(j)\n            tr.append(j)\n            if j not in dic: break\n            j=dic[j]\n        if j in inv: m[i]=inv[j] if len(tr)>1 else -1\n        paths[i]=tr\n    return m,paths,(P,B,U,K,LL,Q,PP,score)\nif __name__=='\"'__main__':\n    import sys\n    init()\n    n,b,g,tu=map(int,sys.argv[1:])\n    coords,seq=get_edges(np.load(f'sk{n}.npy'))\n    p,d=parts(coords,seq,b,g)\n    res=flow(p,d,tune=tu)\n    if res:\n      m,paths,aux=res\n      print(sum(j>=0 for j in m.values()