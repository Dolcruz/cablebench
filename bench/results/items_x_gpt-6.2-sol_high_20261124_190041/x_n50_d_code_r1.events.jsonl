{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command \"@'\nfrom mgraph import *\nfrom ortrack import init,get3\nfrom concurrent.futures import ThreadPoolExecutor\nfrom scipy.spatial import cKDTree\nfrom scipy.sparse import coo_matrix,csgraph\ndef fit(p,extent=19,anchor=5.):\n    ends=[x[::s] for x in p for s in (1,-1)]\n    out=[]\n    for q in ends:\n        d=np.r_[0.,np.cumsum(np.linalg.norm(np.diff(q,axis=0),axis=1))]\n        length=d[-1]\n        s=min(length*.24,anchor)\n        ds=np.linspace(max(0,s-2),min(length,max(2.,extent)),12)\n        P=np.stack([np.interp(ds,d,q[:,j]) for j in (0,1)],axis=1)\n        ii=q.astype(np.int32)\n        u=P[-1]-P[0]; u=u/max(np.linalg.norm(u),1e-4)\n        v=np.array([-u[1],u[0]])\n        center=np.array([np.interp(s,d,q[:,j]) for j in (0,1)])\n        side=(P-center)@v\n        poly=np.polynomial.polynomial.polyfit(ds-s,side,2 if length>12 else 1)\n        if len(poly)==2: poly=np.r_[poly,0.]\n        p0=center+v*np.clip(poly[0],-2,2)\n        ang=np.arctan2(u[1],u[0])+np.arctan(np.clip(poly[1],-.4,.4))\n        aa=ang+np.linspace(-.39,.39,9)[:,None]+2*poly[2]*(ds[None,:]-s)\n        score=get3(P[None,:,0],P[None,:,1],aa)\n        wt=np.exp(-((ds-s)/max(6,(extent-s)*.6))**2)\n        revs=(score*wt).sum(axis=1)/wt.sum()-.07*(np.linspace(-1,1,9)**2)\n        ang+=np.linspace(-.39,.39,9)[revs.argmax()]*.6\n        u=np.array([np.cos(ang),np.sin(ang)])\n        out.append((q[0],p0,u,np.clip(poly[2]*2,-.065,.065),length,revs.max()))\n    P,B,U,K,LL,Q=map(np.array,zip(*out))\n    return P,B,U,K,LL,Q\n\ndef eval_bridge(B,U,K,PP):\n    I,J=PP.T\n    A,E=B[I],B[J]\n    F,H=-U[I],U[J]\n    D=np.linalg.norm(E-A,axis=1)\n    for k in range(0,len(PP),8000):\n        a,e,f,h,d=[x[k:k+8000] for x in (A,E,F,H,D)]\n        q=np.linspace(0,1,16)[None,None,:,None]\n        dist=d[:,None,None,None]*np.array([.7,1,1.27,1.55])[None,:,None,None]\n        C=a[:,None,None,:]+f[:,None,None,:]*dist/3\n        V=e[:,None,None,:]-h[:,None,None,:]*dist/3\n        a=a[:,None,None,:]; e=e[:,None,None,:]\n        xy=(1-q)**3*a+3*q*(1-q)**2*C+3*q*q*(1-q)*V+q**3*e\n        uv=3*(1-q)**2*(C-a)+6*q*(1-q)*(V-C)+3*q*q*(e-V)\n        ang=np.arctan2(uv[...,1],uv[...,0])\n        vals=get3(xy[...,0],xy[...,1],ang)\n        length=np.linalg.norm(uv,axis=-1).mean(axis=-1)\n        dturn=np.angle(np.exp(1j*np.diff(ang,axis=-1)))\n        turn=np.abs(dturn).sum(axis=-1)\n        turncost=np.clip(np.sum(dturn**2,axis=-1)*16/np.maximum(1,length),0,2)\n        fit=vals.mean(axis=-1)\n        result=(fit-.13*turn-.8*turncost)\n        yield np.max(result,axis=1),np.min(turn,axis=1)\ndef plan2(p,d,rad=46,extent=21,cut=.86,pr=.7,cl=.14,anchor=6.,kind=0):\n    P,B,U,K,LL,Q=fit(p,extent,anchor)\n    G=np.empty(len(P),int)\n    for i,ls in enumerate(d): G[ls]=i\n    bound=(P[:,0]<454)|(P[:,0]>3396)\n    pairs=set(cKDTree(B).query_pairs(rad))\n    for g in d: pairs.update(combinations(sorted(g),2))\n    PP=np.array(list(pairs),np.int32); I,J=PP.T\n    same=G[I]==G[J]\n    keep=(I//2\"'!=J//2)&~(bound[I]|bound[J])\n    PP=PP[keep]; I,J=PP.T; same=same[keep]\n    delta=B[J]-B[I]\n    dd=np.linalg.norm(delta,axis=1)\n    def dot(a,b):return (a*b).sum(axis=-1)\n    def cross(a,b):return a[...,0]*b[...,1]-a[...,1]*b[...,0]\n    t0,t1=U[I],U[J]\n    angle=1+dot(t0,t1)\n    side=(abs(cross(t0,delta))+abs(cross(t1,delta)))/(8+.65*dd)\n    wrong=(np.maximum(0,dot(t0,delta)-1)+np.maximum(0,-dot(t1,delta)-1))/(dd+4)\n    shape=.73*angle+.30*side+.83*wrong\n    keep=(shape<1.3)|(same&(shape<1.6))\n    PP=PP[keep];I,J=PP.T; same=same[keep]; shape=shape[keep]; dd=dd[keep]\n    result=list(eval_bridge(B,U,K,PP))\n    evidence=np.concatenate([g[0] for g in result])\n    turn=np.concatenate([g[1] for g in result])\n    co=shape+.013*dd+pr*(.55-evidence)-cl*same\n    benefit=cut-co+.16*(np.minimum(Q[I],Q[J])-.55)-.16*(1-np.minimum(LL[I],LL[J]).clip(0,18)/1