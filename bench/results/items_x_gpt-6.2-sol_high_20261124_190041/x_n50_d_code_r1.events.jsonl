{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command \"@'\nfrom graph import *\nimport warnings\nwarnings.filterwarnings('ignore',category=DeprecationWarning)\nfrom scipy.ndimage import map_coordinates\nfrom scipy.spatial.distance import cdist\ncn=np.load('cnn.npy')\nsc=np.load('score.npy')\ndef plan(p,d,rad=39,cut=1.05,ext=22,offs=4,kc=.16,distpen=.25,difpen=.25):\n    paths=[q[::s] for q in p for s in (1,-1)]\n    P=np.array([q[0] for q in paths])\n    m=len(P)\n    group={i:g for g,ls in enumerate(d) for i in ls}\n    G=np.array([group[i] for i in range(m)])\n    bound=(P[:,0]<454)|(P[:,0]>3396)\n    length=[]; base=[]; direc=[]; curve=[]; center=[]; prob=[]; col=[]\n    for q in paths:\n        ds=np.r_[0.,np.cumsum(np.linalg.norm(np.diff(q,axis=0),axis=1))]\n        leng=ds[-1]\n        length.append(leng)\n        skip=min(leng*.35,offs)\n        stop=max(skip+1,min(leng,ext))\n        DD=np.linspace(skip,stop,13)\n        samp=np.stack([np.interp(DD,ds,q[:,j]) for j in (0,1)],axis=1)\n        dif=samp[-1]-samp[0]\n        u=dif/max(np.linalg.norm(dif),1e-5)\n        v=np.array([-u[1],u[0]])\n        if leng>13:\n            fit=np.polynomial.polynomial.polyfit(DD-2.,samp@v,2)\n            a=np.clip(fit[1],-.35,.35)\n            b=np.clip(fit[2]*2,-.045,.045)\n            B=samp[0]+u*(2-skip)+v*(fit[0]-samp[0]@v)\n        else:\n            a=0\n            b=0\n            B=samp[0]+u*(2-skip)\n        U=(u+a*v)/np.sqrt(1+a*a)\n        center.append(samp[0]); base.append(B); direc.append(U); curve.append(b)\n        ii=np.rint(samp).astype(int)\n        prob.append(np.median(cn[ii[:,1],ii[:,0]]))\n        col.append(np.median(img[ii[:,1],ii[:,0],:].astype(float),axis=0))\n    B=np.array(base); U=np.array(direc); K=np.array(curve); Q=np.array(prob); LL=np.array(length); Col=np.array(col)\n    # Enumerate nearby endpoint pairs in either direction.\n    pairs=set(cKDTree(B).query_pairs(rad))\n    for g in d:\n        pairs.update(combinations(sorted(g),2))\n    PP=np.array(list(pairs),np.int32); I,J=PP.T\n    A,Bb=B[I],B[J]\n    F,H=U[I],U[J]\n    Delta=Bb-A\n    D=np.linalg.norm(Delta,axis=1)\n    def cross(a,b): return a[...,0]*b[...,1]-a[...,1]*b[...,0]\n    def dot(a,b): return (a*b).sum(axis=-1)\n    # Penalize endpoint direction changes and transverse offsets.\n    rev=1+dot(F,H)\n    side=(np.abs(cross(F,Delta))+np.abs(cross(H,Delta)))/2\n    shape=side/(6+D*.21)\n    usek=np.clip(D/2.,0,24)\n    kpred=(K[I]-K[J])/2\n    kshape=(np.abs(cross(F,Delta)+.5*kpred*D**2)+np.abs(cross(H,Delta)-.5*kpred*D**2))/2/(6+D*.21)\n    shape=np.minimum(shape,.4+kshape)\n    wrong=(np.maximum(0,dot(F,Delta)-3)+np.maximum(0,-dot(H,Delta)-3))/(D+7)\n    # Match edges in a common junction when the assumptions are otherwise equal.\n    dist=(D/rad)**1.45\n    col0=Col[I]; col1=Col[J]\n    dc=np.linalg.norm(col0-col1,axis=1)/120\n    co=1.30*rev+.62*shape+1.35*wrong+distpen*dist*2.2+.15*dc-difpen*(G[I]==G[J])\n    benefit=cut-co-(1-np.minimum(LL[I],LL[J]).clip(0,28)/28)*.11+.22*(np.minimum(Q[I],Q[J])-.55)\n    graph=nx.Graph()\n    keep=(benefit>0)&(I//2\"'!=J//2)&~(bound[I]|bound[J])\n    graph.add_weighted_edges_from(zip(I[keep].tolist(),J[keep].tolist(),(benefit[keep]*10000).astype(int).tolist()))\n    mt=nx.max_weight_matching(graph)\n    comp={i:j for a,b in mt for i,j in ((a,b),(b,a))}\n    anchors={}\n    for z,sx in enumerate((450,3400)):\n        for i,y in enumerate([L,R][z]):\n            ds=np.linalg.norm(P-[sx,y],axis=1)\n            q=int(ds.argmin())\n            if ds[q]<11: anchors[q]=(z,i)\n    mapp={}; details={}\n    for i,(z,j) in anchors.items():\n        track=[]; a=i\n        while True:\n            track.append(a)\n            b=a''^1\n            if b in anchors:\n                mapp[z,j]=anchors[b]\n                break\n            if b not in comp: break\n            a=comp[b]\n            if a in track: break\n        details[z,j]=(P[b],track)\n    return mapp,details,comp,(P,B,U,K,Q,LL,Col,PP,co)\nif __name__=='\"'__main__':\n import sys\n for n in map(int,sys.argv[1:]):\n    sk=np.load(f'sk{n}.npy')\n    coords,seq=get_edges(sk)\n    opts=[(8,5),(12,6),(16,9),(8,12),(14,14)]\n    for br,mg in opts:\n      p,d=parts(coords,seq,br,mg)\n      for i,(ra,c,e,o,dp,dip) in enumerate([(37,1.03,19,3,.28,.25),(48,1.20,24,5,.28,.28),(57,1.38,24,5,.35,.32),(65,1.47,28,6,.35,.22),(45,1.18,16,4,.28,.25),(55,1.38,18,2,.35,.33)]):\n        m,det,pair,aux=plan(p,d,ra,c,e,o,.16,dp,dip)\n        same=sum(z==w for (z,k),(w,v) in m.items())\n        f=[m[0,i][1]+1 if (0,i) in m and m[0,i][0] else 0 for i in range(50)]\n        print(n,br,mg,i,len(pair)//2,len(m)//2,same//2,','.join(str(i+1)+'='+str(j) for i,j in enumerate(f) if j),flush=True)\n        np.savez(f'mg{n}_{br}_{mg}_{i}.npz',paths=np.array(p,dtype=object),parts=np.array(d,dtype=object),map=np.array(f),pair=np.array(list(pair.items())),det=np.array(list(det.items()),dtype=object))\n'@ | Set-Content -Encoding utf8 mgraph.py\npython mgraph.py 23 25 27 29\"","aggregated_output":"23 8 5 0 1846 0 0 \r\n23 8 5 1 2034 2 2 \r\n23 8 5 2 2133 6 3 2=11,16=2,49=44\r\n23 8 5 3 2206 9 5 2=11,9=14,12=1,49=44\r\n23 8 5 4 1975 3 3 \r\n23 8 5 5 2094 3 3 \r\n23 12 6 0 1471 1 1 \r\n23 12 6 1 1631 1 1 \r\n23 12 6 2 1732 3 1 2=11,49=44\r\n23 12 6 3 1800 5 2 2=11,12=1,49=44\r\n23 12 6 4 1583 1 1 \r\n23 12 6 5 1703 1 1 \r\n23 16 9 0 1186 1 1 \r\n23 16 9 1 1316 1 1 \r\n23 16 9 2 1394 2 1 2=11\r\n23 16 9 3 1454 2 1 2=11\r\n23 16 9 4 1275 1 1 \r\n23 16 9 5 1367 3 3 \r\n23 8 12 0 1818 0 0 \r\n23 8 12 1 2001 2 2 \r\n23 8 12 2 2099 5 3 2=11,49=44\r\n23 8 12 3 2168 10 6 2=11,9=14,12=1,49=44\r\n23 8 12 4 1941 3 3 \r\n23 8 12 5 2058 3 3 \r\n23 14 14 0 1298 1 1 \r\n23 14 14 1 1439 1 1 \r\n23 14 14 2 1529 2 1 2=11\r\n23 14 14 3 1593 2 1 2=11\r\n23 14 14 4 1395 2 2 \r\n23 14 14 5 1497 2 2 \r\n25 8 5 0 1866 1 1 \r\n25 8 5 1 2047 2 2 \r\n25 8 5 2 2151 4 3 49=46\r\n25