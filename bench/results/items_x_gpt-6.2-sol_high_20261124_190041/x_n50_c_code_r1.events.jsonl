{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command \"@'\nfrom trace import *\nfrom seg import thin,ga,ell,morph\nimport os\nfrom scipy.ndimage import maximum_filter\nB,G,R=im.astype(np.float32).transpose(2,0,1)\nS=R-2*G+B\nS=S-ga(S,3)\nori=np.load('orient.npy',mmap_mode='r')\nangles=np.arange(36)*np.pi/36\nbest=np.zeros_like(S)\nbestamp=np.zeros_like(S)\nbestangle=np.zeros_like(S,dtype='uint8')\np=np.mgrid[-16:17,-16:17].astype('float32')\ny,x=np.mgrid[:h,:w].astype(np.float32)\nstrength=6.9\nfor k,a in enumerate(angles):\n  u=p[1]*np.cos(a)+p[0]*np.sin(a)\n  v=p[0]*np.cos(a)-p[1]*np.sin(a)\n  win=np.exp(-u*u/2/(8.8**2)-v*v/2/(1.3**2))\n  base=win/win.sum()\n  z=u+v*.82\n  cc=base*np.cos(2*np.pi*z/strength)\n  ss=base*np.sin(2*np.pi*z/strength)\n  cc-=base*cc.sum()\n  ss-=base*ss.sum()\n  cr=cv2.filter2D(S,-1,cc)\n  sr=cv2.filter2D(S,-1,ss)\n  amp=np.sqrt(cr*cr+sr*sr)\n  rank=ori[k].astype('float32')\n  bright=ga(R,1)\n  q=rank*np.clip(amp/2.5,.25,1.0)+np.clip(amp,0,15)*2.2\n  take=q>best\n  best[take]=q[take]\n  bestamp[take]=amp[take]\n  bestangle[take]=k\na=angles[bestangle]\nu=-np.sin(a).astype('float32');v=np.cos(a).astype('float32')\nsmooth=ga(best,.7)\nn1=cv2.remap(smooth,x+u*2,y+v*2,cv2.INTER_LINEAR); n2=cv2.remap(smooth,x-u*2,y-v*2,cv2.INTER_LINEAR)\nridge=smooth>=np.maximum(n1,n2)-1.4\nthr=float(os.environ.get('THR',7))\nmask=(ridge & ((smooth>thr)&((bestamp>.68)|(smooth>18)))).astype('uint8')*255\nmask[:50]=0;mask[2130:]=0;mask[:,:410]=0;mask[:,3491:]=0\nmask=morph(mask,cv2.MORPH_CLOSE,5)\nn,l,st,c=cv2.connectedComponentsWithStats(mask,8)\nkeep=(st[:,4]>30);keep[0]=False\nmask=keep[l]*255\nn2,l2,st2,c2=cv2.connectedComponentsWithStats((mask==0).astype('uint8'),4)\nsm=(st2[:,4]<105);sm[0]=False\nmask[sm[l2]]=255\na=thin(mask)\nnp.savez('weaveskel.npz',a=a,score=best,mask=mask)\nout=im.copy();out[mask==0]=(out[mask==0]/3).astype('uint8');out[a>0]=(0,0,255)\ncv2.