]\n    for s,t2 in [(a,b),(b,a)]:\n      u=ways[s]\n      anchor=pos[t2]-vel[t2]*4\n      error=np.linalg.norm(u[:,:,:2]-anchor[:,None,:],axis=2)\n      th=np.arctan2(-vel[t2,1],-vel[t2,0])\n      steer=(1-np.cos(u[:,:,2]-th[:,None]))\n      error=error+18*steer\n      loss=np.min(error,axis=1)\n      both.append(np.clip(loss-2,0,24))\n    pred[sel]=np.minimum(pred[sel],(both[0]+both[1])*.6)\ndist=np.linalg.norm(pos[i]-pos[j],axis=1)\ncost+=float(os.environ.get('SCALE','1.25'))*pred*np.clip(dist/8,0,1)\nprint('local tracker cost',np.percentile(pred,[0,10,30,50,75,100]))\nd.update(cost=cost,predictcost=pred)\npickle.dump(d,open('solution'+dst+'.pkl','wb'))\n'@ | Set-Content -LiteralPath predict.py\npython predict.py\n\"'$env:SRC='\"'predict'\n\"'$env:DST='\"'predict'\n\"'$env:RW='\"'1.1'\n\"'$env:LEN='\"'.075'\n\"'$env:REUSE='\"'26'\n\"'$env:BACK='\"'.045'\n\"'$env:IMG='\"'.3'\npython flow.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
