{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command \"@'\nfrom trace import *\n\ndef arcu(rev, look=22, penalty=500, width=5.7, side=.50, step=4, cap=18, gain=.95, carry=.45, crosspen=0, ls=1):\n    deltas=np.linspace(-.032,.032,33)[None,:]\n    ds=np.array([.25,.5,.75,1,1.25])[None,None,:]*look\n    weights=np.array([.10,.19,.29,.26,.16])\n    x=np.full(50,3480. if rev else 420.)\n    y=(right if rev else left).astype(float)\n    target=420 if rev else 3480\n    direction=-1 if rev else 1\n    theta=np.full(50,np.pi if rev else 0.) - direction*.01\n    omega=np.zeros(50)\n    coords=[np.stack([x,y,theta,x*0],axis=1)]\n    active=np.ones(50,bool)\n    out=np.zeros(50,int)-1\n    def score(xp,yp,t,k,ds):\n        a=k*ds\n        sinc=np.sinc(a/(2*np.pi))\n        xx=xp+np.cos(t+a/2)*sinc*ds\n        yy=yp+np.sin(t+a/2)*sinc*ds\n        c=np.cos(t+a); s=np.sin(t+a)\n        mid=bil(f,xx,yy)\n        l=bil(f,xx-width*s,yy+width*c)\n        r=bil(f,xx+width*s,yy-width*c)\n        resp=mid-(l+r)*side-np.maximum(l,r)*(1.-2.*side)\n        return np.arcsinh(resp/cap)*cap if ls==0 else np.minimum(resp,cap)+np.maximum(resp-cap,0)*.10\n    for i in range(1450):\n        a=np.where(active)[0]\n        if len(a)==0: break\n        xp=x[a,None,None]; yp=y[a,None,None]\n        t=theta[a,None,None]\n        k=(omega[a,None]*carry+deltas)[:,:,None]\n        response=np.sum(score(xp,yp,t,k,ds)*weights,axis=2)\n        obj=response-penalty*(np.abs(deltas)+30*deltas**2) \n        j=obj.argmax(axis=1)\n        best=response[np.arange(len(a)),j]\n        new_k=k[np.arange(len(a)),j,0]*gain\n        if crosspen:\n            new_k*=np.minimum(1,np.maximum(best+2,0)/crosspen)\n        at=new_k*step\n        sinc=np.sinc(at/(2*np.pi))\n        x[a]+=step*np.cos(theta[a]+at/2)*sinc\n        y[a]+=step*np.sin(theta[a]+at/2)*sinc\n        theta[a]+=at\n        omega[a]=.6*omega[a]+.4*new_k\n        valscore=x*0\n        valscore[a]=best\n        coords.append(np.stack([x,y,theta,valscore],axis=1))\n        done=active & ((target-x)*direction<=0)\n        if done.any():\n            out[done]=np.argmin(np.abs(y[done,None]-(left if rev else right)[None,:]), axis=1)\n        active &= ~done & (x>75)&(x<3750)&(y>50)&(y<2130)\n    return out,np.array(coords).transpose(1,0,2)\n\nif __name__=='__main__':\n    import itertools\n    configs=[\n      dict(look=19,penalty=100,cap=28),\n      dict(look=23,penalty=300,cap=55),\n      dict(look=22,penalty=500,cap=20,ls=0),\n      dict(look=35,penalty=250,cap=18),\n      dict(look=19,penalty=300,cap=22,side=.36),\n      dict(look=34,penalty=450,cap=37),\n      dict(look=27,penalty=1300,cap=30,ls=0),\n      dict(look=31,penalty=550,cap=16,side=.4,ls=0),\n      dict(look=18,penalty=320,cap=22,crosspen=12),\n      dict(look=24,penalty=180,cap=16,width=4),\n      dict(look=24,penalty=180,cap=16,width=7),\n    ]\n    for k,cfg in enumerate(configs):\n        for rev in (False,True):\n            o,p=arcu(rev,**cfg)\n            print(k,'R' if rev else 'L', len(set(o[o>=0])),o+1,flush=True)\n            np.savez(f'arc{k}_{int(rev)}.npz',out=o,path=p)\n'@ | Set-Content -LiteralPath arc.py\npython arc.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
