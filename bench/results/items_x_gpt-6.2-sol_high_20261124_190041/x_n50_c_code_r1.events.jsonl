{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command \"@'\nimport cv2,numpy as np,os,pickle\nfrom trace import bil,im\nsrc=os.environ.get('SRC','lock')\ndst=os.environ.get('DST','obs')\nd=pickle.load(open('solution'+src+'.pkl','rb'))\nglobals().update(d)\nbase=np.load('orientskel.npz')['score']\nwoven=np.load('weaveskel.npz')['score']\nori=np.load('orient.npy',mmap_mode='r')\ni,j=cands.T\nmd=np.linalg.norm(pos[i]-pos[j],axis=1)\ngeom=d.get('geom',cost)\nif 'brightness' in d: brightness=d['brightness']\nelse: brightness=np.maximum(20,bil(base,pos[:,0],pos[:,1]))\nwant=np.clip(np.minimum(brightness[i],brightness[j])*.48,9,31)\nca=np.zeros(len(i))\ncapped=(geom<110) & (md>6)\nip=np.where(capped)[0]\nnpt=34\nt=np.linspace(0,1,npt)[None,:,None]\nbeta=4*t*(1-t)\nfor offset in range(0,len(ip),6000):\n    m=ip[offset:offset+6000]\n    a=i[m];b=j[m]\n    xy=pos[a]\n    dif=pos[b]-pos[a]\n    ll=np.maximum(6,md[m])[:,None]\n    res=np.full(len(m),np.inf)\n    for s0,s1,w in [(1,1,0),(.75,1,0),(1,.75,0),(1.2,1,0),(1,1.2,0),(1,1,-1.6),(1,1,1.6),(1,1,-3.2),(1,1,3.2),(.8,.8,0)]:\n        m0=vel[a]*ll*s0;m1=-vel[b]*ll*s1\n        co2=3*dif-2*m0-m1\n        co3=-2*dif+m0+m1\n        p=xy[:,None,:]+m0[:,None,:]*t+co2[:,None,:]*t*t+co3[:,None,:]*t*t*t\n        norm=np.stack([-dif[:,1],dif[:,0]],axis=1)/ll\n        p+=norm[:,None,:]*beta*w\n        dv=m0[:,None,:]+2*co2[:,None,:]*t+3*co3[:,None,:]*t*t+norm[:,None,:]*w*(4-8*t)\n        q=np.arctan2(dv[:,:,1],dv[:,:,0])\n        key=np.round(q*36/np.pi).astype(int)%36\n        xp,yp=p[:,:,0],p[:,:,1]\n        r=np.zeros(xp.shape)\n        for k in np.unique(key):\n            match=key==k\n            r[match]=bil(ori[k],xp[match],yp[match])\n        # Use the visible perpendicular stripe as evidence for an underpass.\n        foreground=bil(base,xp,yp)\n        available=bil(woven,xp,yp)\n        deficit=np.maximum(0,want[m,None]-r)/want[m,None]\n        occlusion=np.clip((foreground-r-8)/20,0,1)\n        support=np.clip(available/17,0,1)\n        outside=np.maximum(0.,1-np.maximum(foreground*.09,available*.08))\n        evidence=np.maximum(0,deficit*.75+outside*.6-occlusion*.55-support*.15)\n        v=evidence[:,2:-2].mean(1)*np.minimum(90,md[m])*.65 + abs(w)*1.25+abs(1-s0)*2+abs(1-s1)*2\n        res=np.minimum(res,v)\n    ca[m]=res\ncost=cost+float(os.environ.get('FORCE','1.35'))*ca\nd.update(cost=cost,obscost=ca)\npickle.dump(d,open('solution'+dst+'.pkl','wb'))\nprint('photo',np.percentile(ca[ip],[10,30,50,70,95]))\n'@ | Set-Content -LiteralPath observe.py\npython observe.py\n\"'$env:SRC='\"'obs'\n\"'$env:DST='\"'obs'\n\"'$env:RW='\"'.75'\n\"'$env:LEN='\"'.075'\n\"'$env:REUSE='\"'26'\n\"'$env:BACK='\"'.045'\n\"'$env:IMG='\"'0'\npython flow.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
