{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command \"@'\nimport numpy as np\nimport networkx as nx\nimport pickle,os\nfrom scipy.ndimage import map_coordinates\nfrom trace import bil, f\npk='solution'+os.environ.get('SRC','')\nd=pickle.load(open(pk+'.pkl','rb'))\nlocals().update(d)\nM=len(ends)\norients=np.load('orient.npy',mmap_mode='r')\ndef oscore(p):\n  delta=p[:,2:]-p[:,:-2]\n  th=np.mod(np.arctan2(delta[:,:,1],delta[:,:,0]),np.pi)*36/np.pi\n  x=p[:,1:-1,0];y=p[:,1:-1,1]\n  rows=np.round(th).astype(int)%36\n  return orients[rows,np.round(y).astype(int).clip(0,2159),np.round(x).astype(int).clip(0,3839)]\ndef colorline(path,bo=2):\n  if len(path)<bo+2:return 0\n  pp=path[bo:-bo]\n  ds=path[2*bo:]-path[:-2*bo]\n  theta=np.mod(np.arctan2(ds[:,1],ds[:,0]),np.pi)*36/np.pi\n  aa=orients[np.round(theta).astype(int)%36,pp[:,1],pp[:,0]]\n  return np.mean(aa)\nconfidence=np.array([colorline(p,4) for p in paths])\ngq=oscore(pts)\nbad=np.maximum(0,17-gq).mean(axis=1)\ncost += bad * .65\ngg=nx.DiGraph()\nleftidx=[i for i,n in port.items() if not n.isdigit()]\nrightidx=[i for i,n in port.items() if n.isdigit()]\nrset=set(rightidx);lset=set(leftidx)\nfor i in range(M):\n    if (i in rset) or (i\"'^1 in lset): continue\n    for v in [i,M+i]:\n        gg.add_node(v, demand=0)\n    ll=lens[i//2]\n    east=ends[i''^1,0]-ends[i,0]\n    penalty=max(0,-east)*float(os.environ.get('\"'BACK',.105))\n    texture_penalty=max(0, 18-confidence[i//2])*.36\n    val=round(100*(penalty+texture_penalty))\n    gg.add_edge(i,M+i,capacity=1,weight=val)\n    if ll<75 and i not in lset and i\"'^1 not in rset and os.environ.get('\"'SHARE','1')=='1':\n      gg.add_node(2*M+i,demand=0)\n      gg.add_edge(i,2*M+i,capacity=1,weight=(val+int(100*float(os.environ.get('REUSE',16)))))\n      gg.add_edge(2*M+i,M+i,capacity=1,weight=0)\nfor (i,j),c in zip(cands,cost):\n    if c>120: continue\n    for p,q in [(i,j),(