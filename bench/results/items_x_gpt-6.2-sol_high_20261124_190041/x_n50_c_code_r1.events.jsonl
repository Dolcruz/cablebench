{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command \"@'\nimport cv2, numpy as np\nfrom scipy.signal import find_peaks\nfrom pathlib import Path\n\nim=cv2.imread('puzzle.png')\ng=cv2.cvtColor(im,cv2.COLOR_BGR2GRAY).astype('float32')\nf=cv2.GaussianBlur(g,(0,0),1.25)\nbase=cv2.GaussianBlur(g,(0,0),6)\nh,w=f.shape\ndef seeds(x):\n    p,_=find_peaks((f-base)[:,x],distance=19,prominence=18)\n    if x<1000: p=p[(p>105)&(p<2120)]\n    else: p=p[(p>65)&(p<2120)]\n    assert len(p)==50,(x,p)\n    return p\nleft=seeds(420); right=seeds(3480)\ndef bil(im,x,y):\n    x=np.clip(x,0,w-1.001); y=np.clip(y,0,h-1.001)\n    i=x.astype(np.int32); j=y.astype(np.int32)\n    u=x-i; v=y-j\n    return (im[j,i]*(1-u)+im[j,i+1]*u)*(1-v)+(im[j+1,i]*(1-u)+im[j+1,i+1]*u)*v\n\ndef run(rev=False, look=12, inertia=30, pre=.72, width=5.5, side=.5, coast=0, step=4, turns=.31):\n    vals=np.linspace(-turns,turns,21)[None,:]\n    ds=np.array([.43,.72,1,1.28])[None,None,:]*look\n    weights=np.array([.23,.31,.3,.16])\n    x=np.full(50, 3480. if rev else 420.)\n    y=(right if rev else left).astype(float)\n    target=420 if rev else 3480\n    direction=-1 if rev else 1\n    theta=np.full(50, np.pi if rev else 0.)\n    omega=np.zeros(50)\n    coords=[np.stack([x,y,theta,x*0],axis=1)]\n    active=np.ones(50,bool)\n    out=np.zeros(50,int)-1\n    for i in range(1450):\n        a=np.where(active)[0]\n        if len(a)==0: break\n        xp=x[a,None,None]; yp=y[a,None,None]\n        predicted=theta[a,None]+omega[a,None]*look*.40\n        t=predicted+vals\n        c=np.cos(t)[:,:,None]; s=np.sin(t)[:,:,None]\n        xx=xp+c*ds; yy=yp+s*ds\n        mid=bil(f,xx,yy)\n        l=bil(f,xx-width*s,yy+width*c)\n        r=bil(f,xx+width*s,yy-width*c)\n        response=np.sum((mid-(l+r)*side-np.maximum(l,r)*(1-2*side))*weights,axis=2)\n        obj=response-inertia*(np.abs(vals)+3*vals**2)\n        j=obj.argmax(axis=1)\n        best=response[np.arange(len(a)),j]\n        newt=t[np.arange(len(a)),j]\n        tdiff=newt-theta[a]\n        alpha=np.where(best<coast,0,1-pre)\n        new_theta=theta[a]+alpha*tdiff+np.where(best<coast,omega[a]*step*.60,0)\n        omega[a]=np.clip(.75*omega[a]+.25*(new_theta-theta[a])/step,-.04,.04)\n        x[a]+=step*np.cos(new_theta)\n        y[a]+=step*np.sin(new_theta)\n        theta[a]=new_theta\n        valscore=x*0\n        valscore[a]=best\n        coords.append(np.stack([x,y,theta,valscore],axis=1))\n        done=active & ((target-x)*direction<=0)\n        if done.any():\n            out[done]=np.argmin(np.abs(y[done,None]-(left if rev else right)[None,:]), axis=1)\n        active &= ~done & (x>75)&(x<3750)&(y>50)&(y<2130)\n    return out,np.array(coords).transpose(1,0,2)\n\nif __name__=='__main__':\n    import sys\n    allconfigs=[\n        {},\n        dict(look=15,inertia=48,pre=.60,coast=8),\n        dict(look=9,inertia=16,pre=.64,coast=6),\n        dict(look=17,inertia=70,pre=.62,coast=9),\n        dict(look=10,inertia=42,pre=.55,coast=8,turns=.46),\n        dict(look=15,inertia=25,pre=.75,coast=8,width=4.7),\n    ]\n    for k,cfg in enumerate(allconfigs):\n        for rev in (False,True):\n            o,p=run(rev=rev,**cfg)\n            print(k,'R' if rev else 'L', len(set(o[o>=0])),o+1,flush=True)\n            np.savez(f'track{k}{int(rev)}.npz',out=o,path=p)\n'@ | Set-Content -LiteralPath trace.py\npython trace.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
