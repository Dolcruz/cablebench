{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command \"@'\nimport cv2, numpy as np, pickle, os\nfrom trace import bil,im\nfrom scipy.ndimage import gaussian_filter1d\nsrc=os.environ.get('SRC','fix');dst=os.environ.get('DST','phase')\nd=pickle.load(open('solution'+src+'.pkl','rb'))\nglobals().update(d)\nB,G,R=im.astype(np.float32).transpose(2,0,1)\nz=R-2*G+B\nrg=R-G\ndef wavep(x,y):\n    return 6.52+.000053*x+.000226*y\n\ndef estimate(p,i):\n    a=np.r_[0,np.cumsum(np.linalg.norm(np.diff(p,axis=0),axis=1))]\n    s=np.arange(0,min(a[-1],52),.4)\n    if len(s)<18:return np.zeros(3,complex),0,np.zeros(3)\n    xy=np.array([np.interp(s,a,p[:,j]) for j in range(2)]).T\n    for k in range(2): xy[:,k]=gaussian_filter1d(xy[:,k],3.5,mode='nearest')\n    # Follow the predicted tangent into the clean segment.\n    rvel=np.gradient(xy,axis=0)\n    rvel/=np.maximum(.001,np.linalg.norm(rvel,axis=1))[:,None]\n    nn=np.stack([rvel[:,1],-rvel[:,0]],1)\n    rx=xy[:,0];ry=xy[:,1]\n    aa=np.r_[0,np.cumsum(np.linalg.norm(np.diff(xy,axis=0),axis=1))]\n    aa+=np.dot(xy[0]-pos[i],-vel[i])\n    l=wavep(rx,ry)\n    coef=2*np.pi*aa/l\n    amps=[]\n    st=[]\n    for off in [-1.2,0,1.2]:\n        xx=rx+off*nn[:,0];yy=ry+off*nn[:,1]\n        zz=bil(z,xx,yy)\n        zz-=gaussian_filter1d(zz,5)\n        wg=np.clip((s-2)/4,0,1)*np.clip((aa[-1]-s)/4,0,1)*np.exp(-.5*(s/28)**2)\n        v=zz*wg\n        c=(v*np.exp(-1j*coef)).sum()/(wg.sum()+1e-9)\n        ratio=abs(c)/np.sqrt(((zz**2*wg).sum()/(wg.sum()+1e-9))+.25)\n        amps.append(c)\n        st.append(ratio)\n    return np.array(amps),float(aa[-1]),np.array(st)\n\namp,ss,coh=map(np.array,zip(*[estimate(p,i) for i,p in enumerate([p for a in paths for p in [a,a[::-1]]])]))\ni,j=cands.T\nstep=np.linalg.norm(np.diff(pts,axis=1),axis=2)\nper=wavep(pts[:,:,0],pts[:,:,1])\narcphase=2*np.pi*(step/((per[:,1:]+per[:,:-1])*.5)).sum(1)\namp1=amp[i];amp2=amp[j][:,::-1]\ncomb=amp1*amp2\npower=np.abs(comb)\nphase=np.angle(comb.sum(1))\nsameness=np.cos(phase-arcphase)\nlengths=step.sum(1)\nstrong=np.clip((np.minimum(coh[i],coh[j][:,::-1]).mean(1)-.18)/.40,0,1)\nstrong*=np.clip((np.minimum(ss[i],ss[j])-7)/13,0,1)\nstrong*=np.clip(np.abs(comb.sum(1))/15,0,1)\nstrong*=np.exp(-.5*(lengths/54)**2)\nscale=float(os.environ.get('PH','9'))\ncost=cost+scale*strong*(1-sameness)\nprint('phase quality',np.percentile(coh.mean(1),[10,25,50,75,90]),np.percentile(strong,[10,25,50,75,90]))\nd.update(cost=cost,phasecost=strong*(1-sameness))\npickle.dump(d,open('solution'+dst+'.pkl','wb'))\n'@ | Set-Content -LiteralPath phase.py\npython phase.py\n\"'$env:SRC='\"'phase'\n\"'$env:DST='\"'phase'\n\"'$env:RW='\"'1.3'\n\"'$env:LEN='\"'0.07'\n\"'$env:REUSE='\"'28'\n\"'$env:BACK='\"'0.04'\n\"'$env:IMG='\"'.40'\npython flow.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
